NODE_ENV=development
PORT=5000

# MongoDB (local instance, or paste an Atlas connection string instead)
MONGO_URI=mongodb://127.0.0.1:27017/TurfTamilnadu

# Auth
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Frontend origin allowed by CORS (comma separated for multiple, e.g. Netlify + local)
CLIENT_URL=http://localhost:5173

# Redis (needed once you run more than one server instance)
REDIS_URL=redis://127.0.0.1:6379

# OTP login: sent to the user's email via SMTP
OTP_EXPIRES_MIN=5

# Email delivery (Gmail example — use an App Password, not your login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=replace_with_sender_email
SMTP_PASS=replace_with_smtp_app_password
SMTP_FROM=